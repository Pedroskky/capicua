{
  "expo": {
    "name": "Capicúa",
    "slug": "capicua",
    "owner": "pedroskky2626s-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "capicua",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B2418",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pedroskky.capicua"
    },
    "android": {
      "package": "com.pedroskky.capicua",
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundImage": "./assets/images/adaptive-icon-background.png",
        "backgroundColor": "#17603C"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B2418",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-status-bar",
      "expo-localization",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "ae7ab5ca-35fc-4851-988d-82f817673387"
      }
    },
    "locales": {
      "es": "./locales/es.json",
      "en": "./locales/en.json"
    }
  }
}
